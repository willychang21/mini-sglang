new file mode 100644
index 0000000000..5be36ccbb4
--- /dev/null
+++ b/test/registered/unit/layers/test_joint_schema_layout.py
@@ -0,0 +1,50 @@
+"""Decision layouts stay importable without the joint schema head and the model
+layer stack, in fresh interpreters without a warmed module cache."""
+
+import subprocess
+import sys
+import unittest
+
+from sglang.test.ci.ci_register import register_cpu_ci
+
+register_cpu_ci(est_time=15, suite="base-a-test-cpu")
+
+
+def _run(code: str) -> subprocess.CompletedProcess:
+    return subprocess.run(
+        [sys.executable, "-c", code],
+        capture_output=True,
+        text=True,
+        timeout=180,
+    )
+
+
+class TestJointSchemaLayoutImports(unittest.TestCase):
+    def test_layout_does_not_load_torch(self):
+        result = _run(
+            "import sys\n"
+            "from sglang.srt.layers.joint_schema_layout import (\n"
+            "    LayoutQuestion, pack_decision_layout, parse_decision_layout)\n"
+            "assert 'torch' not in sys.modules, 'joint_schema_layout imported torch'\n"
+            "q = LayoutQuestion(1, (2, 4), ((5, 6), (6, 8)))\n"
+            "layout = pack_decision_layout(10, [q])\n"
+            "assert parse_decision_layout(layout, 10) == [q]\n"
+        )
+        self.assertEqual(result.returncode, 0, result.stdout + result.stderr)
+
+    def test_systemone_serving_does_not_load_model_layers(self):
+        # The /v1/systemone frontend only validates layouts; the head and the
+        # quantization registry it reaches through the pooler belong to the
+        # scheduler process.
+        result = _run(
+            "import sys\n"
+            "import sglang.srt.entrypoints.systemone.serving\n"
+            "for name in ('sglang.srt.layers.joint_schema_head',\n"
+            "             'sglang.srt.layers.quantization'):\n"
+            "    assert name not in sys.modules, name\n"
+        )
+        self.assertEqual(result.returncode, 0, result.stdout + result.stderr)
+
+
+if __name__ == "__main__":
+    unittest.main()
